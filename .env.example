# Skinfinity environment variables
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# Everything here is prefixed with VITE_ so Vite exposes it to the browser.
# The anon key is public by design — Row Level Security (see supabase/migrations)
# is what protects the data, never the key.
#
# If these are missing the app still runs in "demo mode": it serves the bundled
# sample catalogue from src/lib/demoData.ts and stores orders in localStorage,
# so the storefront can be explored without a backend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: show "Continue with Google" on the sign-in page.
# Requires the Google provider to be enabled in Supabase -> Auth -> Providers.
VITE_ENABLE_GOOGLE_OAUTH=false
